{
  "name": "riff-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "riff-radar": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "trace": "node --disable-warning=ExperimentalWarning --import tsx scripts/trace.ts",
    "eval": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/eval.ts",
    "known-set": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/known-set.ts",
    "taste": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/taste.ts",
    "harvest": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/harvest.ts",
    "check": "npm run typecheck && npm test",
    "smoke:model": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/smoke-model.ts",
    "smoke:sources": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/smoke-sources.ts",
    "smoke:search": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/smoke-search.ts",
    "smoke:musicbrainz": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/smoke-musicbrainz.ts",
    "smoke:coverart": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/smoke-coverart.ts",
    "smoke:notion": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/smoke-notion.ts"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
